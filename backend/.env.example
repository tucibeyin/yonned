# Yonned Backend Environment Configuration
PROJECT_NAME="Yonned API"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
SECRET_KEY="yonned-dev-secret-key-change-in-production-random-64-chars"
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Database (PostgreSQL 17 Async)
DATABASE_URL="postgresql+asyncpg://yonned:yonned_pass@127.0.0.1:5432/yonned_db"

# Cache & Real-Time (Redis 7)
REDIS_URL="redis://127.0.0.1:6379/0"

# Media Storage (Node104 MinIO S3)
MINIO_ENDPOINT="82.39.86.94:9000"
MINIO_ACCESS_KEY="yonned_minio_admin"
MINIO_SECRET_KEY="yonned_minio_secret"
MINIO_BUCKET_NAME="yonned-media"
MINIO_SECURE=False
